STRIPE_STARTUP_PRICE_ID=price_1TdD06DRRNiuPDru4N97bRLc
STRIPE_STARTUP_METERED_PRICE_ID=price_1TdDBADRRNiuPDrufALyFUED

# --- Growth Plan ($99/month) ---
STRIPE_GROWTH_PRODUCT_ID=prod_UcSCoqExvqwFm1
STRIPE_GROWTH_PRICE_ID=price_1TdDHnDRRNiuPDruKSKwXh4s
STRIPE_GROWTH_METERED_PRICE_ID=price_1TdDIXDRRNiuPDruqyHQ2CWT

# --- Scale Plan ($199/month) ---
STRIPE_SCALE_PRODUCT_ID=prod_UcSG30wfJb74wo
STRIPE_SCALE_PRICE_ID=price_1TdDMRDRRNiuPDruCCR20nq1
