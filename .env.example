# AetherCache Local Environment Configuration Template
# Copy this file to '.env' and fill in your actual production/test credentials

PORT=3000

# Stripe API Keys (Retrieve from Stripe Dashboard -> Developers -> API Keys)
# Keep process.env.STRIPE_SECRET_KEY empty to run high-fidelity Stripe Checkout simulations locally!
STRIPE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Stripe Product & Price IDs (4 tiers — base subscription + metered usage)
# Retrieve from Stripe Dashboard -> Products
# ---------------------------------------------------------------------------

